# === Web Panel Backend Settings ===
PORT=3000
JWT_SECRET=supersecretjwtkey

# Admin Login Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# === Minecraft Server Settings (VPS A) ===
# RCON Configuration (Check server.properties)
RCON_HOST=43.133.150.21
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password

# SSH Configuration (To execute systemctl, fetch RAM/CPU, tail logs)
SSH_HOST=43.133.150.21
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your_vps_root_password
# Path to your Minecraft latest.log file
MC_LOG_PATH=/var/opt/minecraft/server/logs/latest.log

# === Telegram Bot Notification ===
# Optional: Get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
